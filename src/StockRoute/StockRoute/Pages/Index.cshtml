@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<form asp-page-handler="Login" method="post">
    Username: <input id="Username" type="text" asp-for="Username" />
    
    Password: <input id="Password" type="password" asp-for="Password" />

    <input id="btnSubmit" type="submit" value="submit" onkeydown="enterKeyPress(event)"/>
</form>


<script type="text/ecmascript"> 
    console.log("Hello from Index.cshtml");
    function enterKeyPress(event) {
        if (event.key === "Enter") {
            document.getElementById("btnSubmit").click();
        }
    }
</script>

